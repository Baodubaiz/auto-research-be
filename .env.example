# Application
PORT=3001
API_PREFIX=api/v1
NODE_ENV=development
IS_LOCAL=true
CORS_ORIGINS="http://localhost:3000"
BODY_LIMIT=10mb

# Authentication (JWT only; no refresh token)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=1d

# Local AI Model URL (as specified in UI/UX documentation)
LOCALLLM_BASE_URL="https://endless-alive-rooster.ngrok-free.app/v1"

# Kafka Configuration
KAFKA="localhost:9092"
KAFKA_CLIENT_ID="autoresearch-backend"
KAFKA_GROUP_ID="autoresearch-group"
KAFKA_SSL=false

# Redis Configuration
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="autoresearch:"
REDIS_CONNECT_TIMEOUT=10000

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autoresearch?schema=public"
