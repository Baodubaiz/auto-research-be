# Application
PORT=3001
API_PREFIX=api/v1
NODE_ENV=development
IS_LOCAL=true

# Local AI Model URL (as specified in UI/UX documentation)
LOCALLLM_BASE_URL="https://endless-alive-rooster.ngrok-free.app/v1"

# Kafka Configuration
KAFKA="localhost:9092"
KAFKA_CLIENT_ID="autoresearch-backend"
KAFKA_GROUP_ID="autoresearch-group"

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autoresearch?schema=public"
