# Application
PORT=3001
API_PREFIX=api/v1
NODE_ENV=development
IS_LOCAL=true
CORS_ORIGINS="http://localhost:3000"
BODY_LIMIT=10mb

# Authentication (JWT only; no refresh token)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=1d

# Local AI Model URL (VPS AI Server)
LOCALLLM_BASE_URL="http://167.254.70.125:8000/v1"

# AI Model Configuration
# AI_DEFAULT_MODEL: Model AI mặc định toàn hệ thống (bắt buộc, ví dụ: gemini-3.5-flash-lite)
AI_DEFAULT_MODEL="gemini-3.5-flash-lite"
# AI_ALLOWED_MODELS: Danh sách model được phép, phân tách bằng dấu phẩy
AI_ALLOWED_MODELS="gemini-3.5-flash-lite,localhost"


# Kafka Configuration (VPS AI Server)
KAFKA="167.254.70.125:9092"
KAFKA_CLIENT_ID="autoresearch-backend"
KAFKA_GROUP_ID="autoresearch-group"
KAFKA_SSL=false

# Redis Configuration (VPS AI Server)
REDIS_ENABLED=false
REDIS_URL="redis://167.254.70.125:6379"
REDIS_KEY_PREFIX="autoresearch:"
REDIS_CONNECT_TIMEOUT=10000

# Database Connection (PostgreSQL with Prisma - Local Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autoresearch?schema=public"

# AI Service Webhook Health-Check Security Key
API_KEY_ID="autoresearch-ai-secret-key"

# Kafka bật/tắt — nguồn cấu hình duy nhất là `kafka.enabled` (src/config/kafka.config.ts)
# Bỏ trống hoặc "true" => BẬT Kafka (bắt buộc ở production). Chỉ đặt "false" khi muốn dùng fallback mock ở dev/test.
KAFKA_ENABLED=

# MongoDB (dùng cho outline/diễn giải của write_content). KHÔNG hard-code, không commit giá trị thật.
# Ví dụ: mongodb://<user>:<password>@<host>:27017/?authSource=admin
MONGO_URI=
