# Application
PORT=3001
API_PREFIX=api/v1
NODE_ENV=production
IS_LOCAL=false
CORS_ORIGINS="https://your-frontend-domain.example"
BODY_LIMIT=10mb

# Authentication
JWT_SECRET="replace-with-a-long-random-production-secret"
JWT_EXPIRES_IN=1d

# Local AI Model URL
LOCALLLM_BASE_URL="https://your-llm-endpoint.example/v1"

# Kafka Configuration
KAFKA="localhost:9092"
KAFKA_CLIENT_ID="autoresearch-backend"
KAFKA_GROUP_ID="autoresearch-group"
KAFKA_SSL=false

# Redis Configuration
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="autoresearch:"
REDIS_CONNECT_TIMEOUT=10000

# PostgreSQL
POSTGRES_USER=autoresearch
POSTGRES_PASSWORD="replace-with-a-strong-production-password"
POSTGRES_DB=autoresearch
